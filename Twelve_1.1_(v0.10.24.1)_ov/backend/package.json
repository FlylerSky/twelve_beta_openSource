{
  "name": "twelve-backend",
  "version": "0.10.24.1.191126",
  "description": "Backend cho nền tảng mạng xã hội Twelve — Twelve 1.1 (0.10.24 + vá bảo mật chuyển từ 2.5.3.3, xem SECURITY-PORT-1.1.md)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:countries": "node src/seed/seedCountries.js",
    "seed:version": "node src/seed/seedVersion.js",
    "migrate:legacy": "node scripts/migrate-legacy-data.js",
    "migrate:legacy:apply": "node scripts/migrate-legacy-data.js --apply",
    "assets:cleanup": "node scripts/cleanup-orphan-assets.js",
    "assets:cleanup:apply": "node scripts/cleanup-orphan-assets.js --apply",
    "test": "node --test test/assets.test.js test/security-110.test.js",
    "content:resanitize": "node src/seed/resanitizeContent.js",
    "content:resanitize:apply": "node src/seed/resanitizeContent.js --apply"
  },
  "dependencies": {
    "cloudinary": "^2.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dompurify": "^3.1.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "file-type": "^21.3.4",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "jsdom": "^24.1.1",
    "multer": "^2.0.2",
    "nanoid": "^3.3.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

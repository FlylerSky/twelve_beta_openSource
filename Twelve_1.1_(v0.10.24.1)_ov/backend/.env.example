# ==== Server ====
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
# (v1.1: đã BỎ COOKIE_SECRET — Twelve không dùng cookie, cookie-parser đã được gỡ khỏi dependency.)

# ==== Firebase Admin SDK ====
# Cách 1 (khuyên dùng trên Render): dán toàn bộ nội dung file service-account.json
# đã được chuyển thành 1 dòng JSON vào biến này.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Cách 2: nếu không dùng biến trên, có thể set 3 biến rời:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ==== Cloudinary ====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== App ====
# (v0.4) Không còn dùng Resend / mã kích hoạt tùy chỉnh.
# Email xác minh tài khoản do Firebase Authentication gửi (template cấu hình
# trong Firebase Console > Authentication > Templates > Email address verification).
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_VERSION=0.10.24.1.191126

# ==== CAPTCHA (Cloudflare Turnstile) ====
# BẮT BUỘC khi NODE_ENV=production kể từ v0.8.5 — server sẽ TỪ CHỐI KHỞI ĐỘNG
# nếu thiếu biến này ở production (xem assertCaptchaConfigured() trong
# src/middleware/captcha.js, gọi từ server.js). Đây là bản vá triệt để cho lỗ
# hổng #4 (đăng ký hàng loạt): v0.8.3/0.8.4 để CAPTCHA "tắt mặc định, bật khi
# có cấu hình", nhưng thực tế production chưa từng cấu hình -> CAPTCHA bị bỏ
# qua hoàn toàn mà không ai biết, kiểm thử v0.8.4 xác nhận 5 request đăng ký
# liên tiếp không kèm token vẫn thành công.
# Lấy site key + secret key từ https://dash.cloudflare.com/?to=/:account/turnstile,
# đặt secret key ở đây; site key tương ứng đặt ở frontend/.env
# (VITE_TURNSTILE_SITE_KEY) — 2 giá trị PHẢI cùng 1 cặp site Turnstile.
# Chỉ được để trống khi NODE_ENV khác "production" (dev cục bộ).
TURNSTILE_SECRET_KEY=

# ==== Chữ ký link share (v0.8.20, bắt buộc ở production) ====
# Dùng để ký (HMAC-SHA256) link share — chống giả mạo sharerUid (ai cũng có
# thể nhặt uid người khác từ URL trang Profile rồi tự chế link share để
# "cấy" positiveScore). Tạo 1 chuỗi ngẫu nhiên dài, ví dụ chạy:
#   openssl rand -hex 32
# rồi dán kết quả vào đây. KHÔNG dùng chung giá trị này cho bất kỳ mục đích
# nào khác, và KHÔNG đổi giá trị này sau khi đã phát hành link share (link
# cũ sẽ hết hiệu lực ghi công nếu đổi secret).
SHARE_LINK_SECRET=

# ==== Trending — mốc hiệu lực tính mã tuần (v0.10.0, tuỳ chọn) ====
# Ngày mà tuần chứa nó được tính là "tuần tổng N=1" cho trang Xu hướng, định
# dạng YYYY-MM-DD. Mặc định nếu để trống: 2026-09-19 (ngày tính năng này
# được triển khai). CHỈ nên chỉnh sửa giá trị này TRƯỚC KHI có tuần nào thực
# sự được chốt/lưu vĩnh viễn vào collection `weeklyLeaderboards` — đổi sau
# đó sẽ làm lệch mã tuần so với dữ liệu lịch sử đã lưu.
TRENDING_EPOCH_DATE=

# ==================================================================================================
# ==== TWELVE 1.1 (0.10.24.1.191126) — biến môi trường MỚI/ĐỔI cho các bản vá bảo mật (xem SECURITY-PORT-1.1.md) ====
# ==================================================================================================
# CẢNH BÁO: khi triển khai thật NODE_ENV PHẢI là `production`. `development` tắt kiểm tra fail-fast và cho ai cũng đếm được view SSR.

# [KHUYÊN DÙNG — đặt CÙNG GIÁ TRỊ ở Render (đây) và Vercel (Project Settings > Environment Variables)] bí mật giữa middleware Vercel và backend.
# Chỉ request mang header khớp mới được cộng view/AI-view từ trang SSR (bot/AI) và được nới hạn mức cho crawler. Tạo bằng: openssl rand -hex 32
# Thiếu biến này: trang SSR vẫn hiển thị bình thường nhưng KHÔNG cộng view (an toàn); server chỉ in cảnh báo, KHÔNG từ chối khởi động.
SSR_PROXY_SECRET=

# [TW-01] Nhận diện IP client. MẶC ĐỊNH `cloudflare` (tin dải IP Cloudflare + dải nội bộ, không phụ thuộc số hop) — đã đo trên Render thật (X-Forwarded-For = "client, CFedge, 10.x"),
# còn `trust proxy = 1` của 0.10.24 cho khoá = IP nội bộ Render xoay vòng (mọi limiter theo IP không còn theo người dùng). KHÔNG cần đặt trên Render.
# Chỉ đặt "hops" (+ TRUST_PROXY_HOPS) để quay lại cách cũ, hoặc khi dời sang nền tảng không có Cloudflare/proxy nội bộ. Đổi biến phải khởi động lại.
# TRUST_PROXY_MODE=cloudflare   # cloudflare (mặc định) | hops
# TRUST_PROXY_EXTRA=            # (cloudflare) thêm dải proxy tin cậy, IP/CIDR phân cách dấu phẩy
# TRUST_PROXY_HOPS=1            # chỉ có tác dụng khi TRUST_PROXY_MODE=hops
# CLOUDFLARE_EXTRA_RANGES=      # bổ sung dải Cloudflare mới nếu Cloudflare công bố thêm
# DEBUG_IP_TOPOLOGY=on          # BẬT TẠM để đo (in 20 dòng "[IP-TOPO]" vào log khi có request), đo xong gỡ ngay

# [F3 / TW-03] Điểm xem chỉ cộng 1 lần cho mỗi cặp (người xem, bài). MẶC ĐỊNH BẬT. Đặt "off" để quay về hành vi 0.10.24 (cộng lại sau mỗi 30 phút — cày được điểm).
# VIEW_SCORE_ONCE_PER_PAIR=off
# [TW-03] Trần thưởng chia sẻ: số lần +8 điểm tối đa mỗi NGÀY (UTC) cho một người chia sẻ. Mặc định 25; 0 hoặc "off" = không giới hạn. shareCount hiển thị không đổi.
# SHARE_REWARD_DAILY_CAP=25
# [TW-27] Log chẩn đoán chia sẻ `[SHARE DEBUG]`: tắt mặc định; bật khi cần chẩn đoán (tối đa 20 dòng/phút).
# SHARE_DEBUG=on

# [A-04] (tuỳ chọn) thêm tên vào danh sách Tag Name Search dành riêng, phân cách bằng dấu phẩy (đã chặn sẵn admin/twelve/support/moderator/official/security…).
# RESERVED_TAG_NAMES_EXTRA=ceo,founder

# [F1/F10] Sanitize HTML bài viết chạy ở worker_threads có timeout cứng (services/contentPipeline.js). Đặt "off" CHỈ khi môi trường không có worker_threads.
# SANITIZE_WORKER=off

# [TW-10] Turnstile: timeout gọi siteverify (ms, 1000–15000, mặc định 5000) và kiểm hostname của widget (chỉ ở production).
# Hostname hợp lệ mặc định = hostname của CORS_ORIGIN + FRONTEND_URL. Đặt tường minh nếu widget chạy ở tên miền khác; "*.example.com" được phép.
# TURNSTILE_TIMEOUT_MS=5000
# TURNSTILE_ALLOWED_HOSTNAMES=twelveta.vercel.app
# TURNSTILE_HOSTNAME_CHECK=off   # công tắc khẩn: tắt kiểm hostname nếu đăng ký bị chặn nhầm

# ==== Backend API ====
VITE_API_BASE_URL=http://localhost:8080/api

# ==== Firebase Client SDK (lấy từ Firebase Console > Project settings > Web app) ====
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==== Chỉ dùng bởi middleware.js (chạy trên Vercel, KHÔNG lộ ra bundle JS) ====
# URL gốc của twelve-backend, dùng để proxy bot/crawler sang bản SSR (SEO).
# Khai báo biến này ở Vercel > Project Settings > Environment Variables
# (KHÔNG cần tiền tố VITE_ vì đây không phải biến phía client).
BACKEND_ORIGIN=https://your-backend.onrender.com

# ==== CAPTCHA (Cloudflare Turnstile) ====
# BẮT BUỘC ở production kể từ v0.8.5 (xem VÁ #4 trong backend/src/middleware/captcha.js
# — kiểm thử v0.8.4 phát hiện CAPTCHA chưa từng được bật thật ở production vì
# thiếu biến này/TURNSTILE_SECRET_KEY, khiến đăng ký hàng loạt không bị chặn).
# Site key CÔNG KHAI của Cloudflare Turnstile (khác secret key ở backend!) —
# lấy cùng lúc với TURNSTILE_SECRET_KEY từ https://dash.cloudflare.com/?to=/:account/turnstile.
# Chỉ để trống khi chạy DEV cục bộ (backend cũng chỉ bỏ qua CAPTCHA khi
# NODE_ENV khác "production"). PHẢI khớp cặp site key/secret key với backend,
# nếu không người dùng thật sẽ bị chặn đăng ký (backend đòi token nhưng
# frontend không gửi được).
VITE_TURNSTILE_SITE_KEY=

# ==== v1.1 — biến của MIDDLEWARE VERCEL (không có tiền tố VITE_, KHÔNG đưa vào bundle; đặt ở Vercel > Project Settings > Environment Variables) ====
# SSR_PROXY_SECRET: bí mật dùng chung với backend (đặt CÙNG giá trị với SSR_PROXY_SECRET ở Render). Middleware gắn nó vào request chuyển sang backend để backend biết request SSR là thật.
# Tạo bằng: openssl rand -hex 32. Thiếu => trang SSR vẫn chạy nhưng backend không cộng view/AI-view từ bot.
# SSR_PROXY_SECRET=
